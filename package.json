{
  "name": "lidovci-rtyne-web",
  "version": "0.1.0",
  "description": "Web místní organizace KDU-ČSL Rtyně v Podkrkonoší (Jekyll + Tailwind CSS).",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./_tailwindcss/main.css -o ./assets/css/style.css --minify",
    "watch:css": "tailwindcss -i ./_tailwindcss/main.css -o ./assets/css/style.css --watch",
    "dev": "concurrently -k -n \"CSS,JEKYLL\" -c \"yellow,black\" \"npm:watch:css\" \"bundle exec jekyll serve --livereload\"",
    "build": "npm run build:css && bundle exec jekyll build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17"
  }
}
